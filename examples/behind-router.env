# Caw behind a router (home or office) that forwards ports to this machine. Caddy gets the HTTPS cert.
# cp examples/behind-router.env .env, fill in the blanks, docker compose up -d --build
# Forward from the router to this machine: 80, 443 tcp+udp, 3478 tcp+udp and 49160-49200 udp (same port numbers on both sides).

# address people open in the browser
CAW_PUBLIC_URL=https://caw.example.com
# run the bundled Caddy for HTTPS
COMPOSE_PROFILES=caddy
# domain Caddy gets the certificate for; DNS must point at your public IP
CAW_DOMAIN=caw.example.com

# shared by Caw and coturn to sign call relay logins; generate with: openssl rand -hex 32
CAW_TURN_SECRET=
# coturn's realm, normally the domain
CAW_TURN_REALM=caw.example.com
# relay addresses handed to apps for calls
CAW_TURN_URLS=turn:caw.example.com:3478?transport=udp,turn:caw.example.com:3478?transport=tcp
CAW_STUN_URLS=stun:caw.example.com:3478
# public IP / this machine's LAN IP, so coturn hands out the address the router forwards
CAW_TURN_EXTERNAL_IP=203.0.113.10/192.168.1.20
# relay port range; must match the router's port forward
CAW_TURN_MIN_PORT=49160
CAW_TURN_MAX_PORT=49200
