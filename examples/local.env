# Caw on this machine only; calls work between tabs/browsers on it.
# cp examples/local.env .env, docker compose up -d --build, open http://localhost:8080

# localhost counts as secure, so the mic works without https
CAW_PUBLIC_URL=http://localhost:8080
CAW_PORT=8080

# coturn still starts; any value works locally
CAW_TURN_SECRET=local-only
CAW_TURN_REALM=localhost
CAW_STUN_URLS=stun:localhost:3478
