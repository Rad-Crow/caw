# Caw on a server with its own public IP (VPS, dedicated box). Caddy gets the HTTPS cert.
# cp examples/public-server.env .env, fill in the blanks, docker compose up -d --build
# Open 80, 443 tcp+udp, 3478 tcp+udp and 49160-49200 udp in the firewall.

# address people open in the browser
CAW_PUBLIC_URL=https://caw.example.com
# run the bundled Caddy for HTTPS
COMPOSE_PROFILES=caddy
# domain Caddy gets the certificate for; DNS must point at this server
CAW_DOMAIN=caw.example.com

# shared by Caw and coturn to sign call relay logins; generate with: openssl rand -hex 32
CAW_TURN_SECRET=
# coturn's realm, normally the domain
CAW_TURN_REALM=caw.example.com
# relay addresses handed to apps for calls
CAW_TURN_URLS=turn:caw.example.com:3478?transport=udp,turn:caw.example.com:3478?transport=tcp
CAW_STUN_URLS=stun:caw.example.com:3478
