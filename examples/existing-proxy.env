# Caw behind a reverse proxy you already run (nginx, Traefik, another Caddy). The proxy does HTTPS.
# cp examples/existing-proxy.env .env, fill in the blanks, docker compose up -d --build
# Point the proxy at Caw's port with websockets on /ws. Open 3478 tcp+udp and 49160-49200 udp for calls;
# coturn doesn't go through the proxy.

# address people open in the browser (the proxy's https address)
CAW_PUBLIC_URL=https://caw.example.com
# COMPOSE_PROFILES unset, so the bundled Caddy stays off

# where Caw listens for the proxy; use 0.0.0.0 if the proxy runs on another machine
CAW_LISTEN=127.0.0.1
CAW_PORT=8080

# shared by Caw and coturn to sign call relay logins; generate with: openssl rand -hex 32
CAW_TURN_SECRET=
# coturn's realm, normally the domain
CAW_TURN_REALM=caw.example.com
# relay addresses handed to apps for calls; this host must be reachable directly, not via the proxy
CAW_TURN_URLS=turn:caw.example.com:3478?transport=udp,turn:caw.example.com:3478?transport=tcp
CAW_STUN_URLS=stun:caw.example.com:3478
